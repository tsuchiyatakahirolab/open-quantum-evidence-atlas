{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-quantum-evidence-atlas",
  "main": "worker.atlas.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["dist/server/**/*.js", "dist/server/**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "atlas.tsuchiyalab.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
