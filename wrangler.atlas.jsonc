{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-quantum-evidence-atlas",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "atlas.tsuchiyalab.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
